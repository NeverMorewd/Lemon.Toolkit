<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Lemon.Toolkit.Views.PlaygroundOllamaView"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="*,*,*,*">
        <TextBox Name="question" />
        <Button
            Command="{Binding AskCommand}"
            CommandParameter="{Binding ElementName=question, Path=Text}"
            Content="Ask"
            Grid.Row="1" />
        <TextBox
            Grid.Row="2"
            IsReadOnly="True"
            Text="{Binding ReplyContent}" />
    </Grid>
</UserControl>
