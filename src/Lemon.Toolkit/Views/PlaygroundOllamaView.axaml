<UserControl
    x:Class="Lemon.Toolkit.Views.PlaygroundOllamaView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid RowDefinitions="200,*,auto,auto">
        <DockPanel Grid.Row="0" LastChildFill="True">
            <TextBox
                DockPanel.Dock="Bottom"
                IsReadOnly="True"
                Text="{Binding ReplyContent}" />

            <Button
                Margin="3,1,3,1"
                Command="{Binding AskCommand}"
                CommandParameter="{Binding ElementName=question, Path=Text}"
                Content="Ask"
                DockPanel.Dock="Right"
                IsDefault="True" />
            <TextBox Margin="2" Name="question" Watermark="Ask anything" />
        </DockPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding ApiCollection}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="100,100,*,100">
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="{Binding Name}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{Binding Verb}" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Text="{Binding Path}" />
                        <Button
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Command="{Binding MockApiCommand}"
                            Content="Mock" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
