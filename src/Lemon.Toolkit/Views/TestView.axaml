<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Lemon.Toolkit.TestView"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="*,*,*,*">
        <Button Command="{Binding TestCommand}" Content="Test" />
        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="2">
            <TextBox Name="Path" />
            <Button
                Command="{Binding AddPathCommand}"
                CommandParameter="{Binding ElementName=Path, Path=Text}"
                Content="Add to Path" />
        </StackPanel>
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="2">
            <TextBox Text="{Binding SourceFilePath}" Name="Sourcefile" Width="200" />
            <Button
                Command="{Binding BrowseCommand}"
                Content="Browse" />
            <Button
                Command="{Binding ParseCommand}"
                CommandParameter="{Binding ElementName=Sourcefile, Path=Text}"
                Content="ParseToDb" />
        </StackPanel>
    </Grid>
</UserControl>
