<UserControl
    x:Class="Lemon.Toolkit.Views.ChromePreferenceInspector"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid RowDefinitions="Auto, 300, Auto, Auto">
        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Spacing="5">
            <TextBox
                Width="700"
                Height="40"
                Classes="Bordered"
                Text="{Binding FilePath}"
                Watermark="Enter filepath or Select a file with the button 'Browse'" />
            <Button Command="{Binding BrowseFileCommand}" Content="Browse" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="Orange"
                Text="{Binding FileSize}" />
        </StackPanel>
    </Grid>
</UserControl>
