<UserControl
    x:Class="Lemon.Toolkit.Views.ToolBoxView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <HeaderedContentControl Header="Git Settings">
        <StackPanel Spacing="3">
            <StackPanel Orientation="Horizontal" Spacing="3">
                <TextBox Text="{Binding GitProxyPort}" />
                <ToggleSwitch
                    IsChecked="{Binding EnableGitProxy, Mode=TwoWay}"
                    OffContent="Disable Proxy"
                    OnContent="Enable Proxy" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="3">
                <TextBlock Text="{Binding CurrentGitProxyInfo}" />
                <Button Command="{Binding GetProxySettingsCommand}" Content="View Settings" />
            </StackPanel>
        </StackPanel>
    </HeaderedContentControl>
</UserControl>
